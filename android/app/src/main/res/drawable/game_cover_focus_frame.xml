<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus indicator for the cover grid. The list view gets one for free because
  its rows are MaterialCardViews with a ripple; the cover cells are plain
  ConstraintLayouts, so with a controller there was nothing at all to show
  which game was selected. Drawn as a foreground so it sits over the artwork.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <stroke
        android:width="3dp"
        android:color="@color/xemu_green" />
      <corners android:radius="20dp" />
      <solid android:color="#1FFFFFFF" />
    </shape>
  </item>
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <stroke
        android:width="3dp"
        android:color="@color/xemu_green" />
      <corners android:radius="20dp" />
      <solid android:color="#33FFFFFF" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@android:color/transparent" />
    </shape>
  </item>
</selector>
