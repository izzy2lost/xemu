NC_SKIP(Cpu8051State, xdata_write)
NC_SKIP(Cpu8051State, sfr_read_cb)
NC_SKIP(Cpu8051State, sfr_write_cb)
NC_F(Cpu8051State, in_interrupt, BOOL, 1, 1, 0)
